{
 "version": 1,
 "name": "Long-video spec (calibrated on one 15-minute reference video)",
 "about": "Targets for a long animated video, checked by scripts/video_qa.py. Plan targets: a mix measured on the first 15 minutes of one reference video, labelled by eye every 3 seconds. Pixel targets: that video's per-window p10 to p90. Judging: PASS inside the range, WARN within 25 % of the range width outside, FAIL beyond; a rule FAILs when fewer than 50 % of its windows pass. Edit the numbers or re-make them with --calibrate on your own reference.",
 "rules": [
  {
   "id": "whole.map",
   "metric": "plan_whole.share.map",
   "text": "Whole: map share",
   "window": 60,
   "min": 0.28,
   "max": 0.42,
   "scope": "whole"
  },
  {
   "id": "whole.narrator",
   "metric": "plan_whole.share.narrator",
   "text": "Whole: Narrator share",
   "window": 60,

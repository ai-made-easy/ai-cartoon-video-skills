 "structure": {
  "source": "reference video 0-15 min, 300 frames every 3 s, hand-labelled (sampling rounds lengths to 3 s)",
  "segment_s": {
   "median": 6,
   "p90": 15
  },
  "family_segment_s": {
   "median": 9,
   "p90": 15
  },
  "type_changes_per_min": 6.2,
  "segment_by_type_s": {
   "map": {
    "median": 9,
    "p90": 21,
    "max": 27
   },
   "narrator_wall": {
    "median": 9,
    "p90": 15,
    "max": 21
   },
   "narrator_over_picture": {
    "median": 4.5,
    "p90": 9
   },
   "story": {
    "median": 9,
    "p90": 15,
    "max": 15
   },
   "full_image": {
    "median": 9,
    "max": 9
   },
   "card_on_map": {
    "median": 6,
    "max": 6
   },
   "narrator_in_drawn_set": {
    "max": 24
   }
  },
  "transitions": {
   "map>narrator": 22,
   "narrator>map": 20,
   "narrator>story": 10,
   "story>narrator": 9,
   "story>map": 6,
   "map>story": 6,
   "narrator>image": 3,
   "image>narrator": 3
  },
  "recurrence_s": {
   "map": {
    "median": 22.5,
    "max": 84
   },
   "narrator": {
    "median": 18,
    "max": 72
   },
   "story": {
    "median": 36,
    "max": 150
   },
   "image": {
    "median": 108
   }
  },
  "story_scenes_per_15min": 15,
  "minutes_with_a_scene": "11 of 15"
 },
 "calibration": {
  "source": "reference video 0:00-15:00, sponsor read (282-351 s) excluded",
  "date": "2026-11-10"
 },
 "cadence": {
  "about": "Hard rules: within every X seconds, Y must happen. Checked on the whole timeline (excluded spans such as a sponsor read do not count); every gap longer than X is reported with its time. X = the reference video's worst gap, rounded up, so the reference passes its own test. The last skip_end_s seconds of a whole video (a subscribe ending) are exempt.",
  "rules": [
   {
    "id": "new",
    "kind": "new",
    "every_s": 4,
    "pixel_changed": 0.01,
    "text": "something new on screen (a plan event, a cut, or >= 1 % of pixels changing in 0.5 s)",
    "suggested_s": 3
   },
   {
    "id": "events",
    "kind": "events",
    "every_s": 10,
    "min_events": 3,
    "text": "at least 3 new on-screen events (pins, labels, cards, poses, lines, counters) in any 10 s"
   },
   {
    "id": "motion",
    "kind": "motion",
    "every_s": 4,
    "pixel_changed": 0.002,
    "text": "a camera move or a cut (no frozen picture)",
    "suggested_s": 15
   },
   {
    "id": "typechange",
    "kind": "typechange",
    "every_s": 28,
    "text": "the picture type changes (map / narrator / story scene / image / card / text)",
    "suggested_s": 20
   },
   {
    "id": "offmap",
    "kind": "offmap",
    "every_s": 40,
    "text": "leave the map at least once",
    "suggested_s": 40
   },
   {
    "id": "narrator",
    "kind": "narrator",
    "every_s": 60,
    "text": "the narrator appears",
    "suggested_s": 60
   },
   {
    "id": "story",
    "kind": "story",
    "every_s": 140,
    "text": "a cartoon story scene appears",
    "suggested_s": 120
   },
   {
    "id": "image",
    "kind": "image_max",
    "every_s": 9,
    "text": "a full-screen image ends (max hold)",
    "suggested_s": 9
   },
   {
    "id": "acting_pose",
    "kind": "acting_pose",
    "every_s": 3,
    "text": "inside a story scene: a pose or expression change"
   },
   {
    "id": "acting_line",
    "kind": "acting_line",
    "every_s": 6,
    "text": "inside a story scene: a spoken line or bubble appears"
   }
  ],
  "tuning": "every_s = the reference's worst gap rounded up (first 15 min, sponsor read skipped; plan rules come from 3-second tags, so plus or minus 1.5 s). suggested_s = a stricter first proposal. The acting rules come from 3-fps bursts of the reference's dialogue scenes.",
  "skip_end_s": 35
 }
}